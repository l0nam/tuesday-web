DATABASE_URL=mysql://tuesday_app:URL_ENCODED_PASSWORD@127.0.0.1:3306/tuesday_web
# false | true (TLS с проверкой сертификата) | no-verify (TLS, самоподписанный сертификат)
DATABASE_SSL=false

DISCORDSRV_DATABASE_URL=mysql://tuesday_discordsrv_ro:URL_ENCODED_PASSWORD@127.0.0.1:3306/discordsrv_database
DISCORDSRV_DATABASE_SSL=false
DISCORDSRV_TABLE=discordsrv_accounts
DISCORDSRV_DISCORD_COLUMN=discord
DISCORDSRV_UUID_COLUMN=uuid

BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=https://example.com
DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_WITH_DISCORD_CLIENT_SECRET

PLUGIN_API_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Used by the external scheduler for /api/cron/online (minimum 32 characters)
ONLINE_CRON_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

SITE_TIMEZONE=Europe/Moscow
